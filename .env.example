# Supabase — proyecto del Adrián Method
# URL pública del proyecto (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# anon/public key (Settings > API). Segura para exponer al cliente:
# el acceso real lo controlan las políticas RLS de supabase/schema.sql
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dominio de producción (sin barra final), ej. https://adrianmethod.com
# Usado para generar URLs absolutas de las imágenes Open Graph/Twitter.
# Si no se define, cae automáticamente a la URL de deploy de Vercel.
NEXT_PUBLIC_SITE_URL=
